# From @BotFather when you created the bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere

# Numeric chat id of your channel (bot must be an ADMIN of this channel).
# For public channels you can usually use @channelusername instead.
TELEGRAM_CHANNEL_ID=-1001234567890

# Any long random string — used to sign short-lived download tokens
DOWNLOAD_TOKEN_SECRET=replace-with-a-long-random-string

# Public (browser-visible) values for the deep-link button
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername
NEXT_PUBLIC_TELEGRAM_CHANNEL_LINK=https://t.me/yourchannel

# From upstash.com — free Redis used to pass verification status
# from the webhook to the polling frontend
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
